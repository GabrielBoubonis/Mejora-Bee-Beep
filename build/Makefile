	cd src/ && ( test -e Makefile || $(QMAKE) -o Makefile C:/Mejora-Bee-Beep/beebeep-code-r1612/src/src.pro -spec win32-g++ CONFIG+=release ) && $(MAKE) -f Makefile benchmark
sub-plugins-benchmark_ordered: sub-src-benchmark_ordered 
	@test -d plugins/ || mkdir -p plugins/
	cd plugins/ && ( test -e Makefile || $(QMAKE) -o Makefile C:/Mejora-Bee-Beep/beebeep-code-r1612/plugins/plugins.pro -spec win32-g++ CONFIG+=release ) && $(MAKE) -f Makefile benchmark
benchmark: sub-src-benchmark_ordered sub-plugins-benchmark_ordered
install:install_subtargets  FORCE

uninstall: uninstall_subtargets FORCE

