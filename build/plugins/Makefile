sub-rainbowtextmarker-debug:
	@test -d rainbowtextmarker/ || mkdir -p rainbowtextmarker/
	cd rainbowtextmarker/ && ( test -e Makefile || $(QMAKE) -o Makefile C:/Mejora-Bee-Beep/beebeep-code-r1612/plugins/rainbowtextmarker/rainbowtextmarker.pro -spec win32-g++ CONFIG+=release ) && $(MAKE) -f Makefile debug
sub-numbertextmarker-debug:
	@test -d numbertextmarker/ || mkdir -p numbertextmarker/
	cd numbertextmarker/ && ( test -e Makefile || $(QMAKE) -o Makefile C:/Mejora-Bee-Beep/beebeep-code-r1612/plugins/numbertextmarker/numbertextmarker.pro -spec win32-g++ CONFIG+=release ) && $(MAKE) -f Makefile debug
sub-regularboldtextmarker-debug:
	@test -d regularboldtextmarker/ || mkdir -p regularboldtextmarker/
	cd regularboldtextmarker/ && ( test -e Makefile || $(QMAKE) -o Makefile C:/Mejora-Bee-Beep/beebeep-code-r1612/plugins/regularboldtextmarker/regularboldtextmarker.pro -spec win32-g++ CONFIG+=release ) && $(MAKE) -f Makefile debug
debug: sub-rainbowtextmarker-debug sub-numbertextmarker-debug sub-regularboldtextmarker-debug

